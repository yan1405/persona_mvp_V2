NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use somente quando o projeto ainda tiver apenas a chave publica legada `anon`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Persona Live — NVIDIA API, somente no servidor.
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash

# Demais recursos de IA — mantenha a chave somente no servidor e nunca use o prefixo NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# SOMENTE QA local: login por senha em /entrar (contas descartaveis do Supabase de QA).
# Nunca na Vercel; nunca em Preview/Production. Fica desligado com NODE_ENV=production, VERCEL ou VERCEL_ENV
# definidos, ou host diferente de localhost/127.0.0.1/[::1]. Nunca usar prefixo NEXT_PUBLIC_.
# PERSONA_QA_PASSWORD_LOGIN=1
