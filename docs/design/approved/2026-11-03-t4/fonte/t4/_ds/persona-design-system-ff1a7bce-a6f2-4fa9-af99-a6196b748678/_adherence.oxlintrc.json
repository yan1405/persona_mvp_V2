{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/agent/**",
              "components/artifacts/**",
              "components/chat/**",
              "components/core/**",
              "components/entries/**",
              "components/evidence/**",
              "components/flow/**",
              "components/forms/**",
              "components/live/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/score/**",
              "components/shell/**",
              "components/surfaces/**",
              "components/trace/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Inter, Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onToggle|screen|messages|onSend|onAction|composerProps|emptyText|style|key|ref|className|style|children)$/]",
        "message": "<AgentPanel> doesn't accept that prop. Declared props: open, onToggle, screen, messages, onSend, onAction, composerProps, emptyText, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentPrompt'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|value|onChange|onSubmit|suggestions|onSuggestion|placeholder|shortcut|style|key|ref|className|style|children)$/]",
        "message": "<AgentPrompt> doesn't accept that prop. Declared props: size, value, onChange, onSubmit, suggestions, onSuggestion, placeholder, shortcut, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentPrompt'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:large|compact)$/]",
        "message": "<AgentPrompt> size must be one of 'large' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|agentOpen|onAgentToggle|searchValue|onSearchChange|onSearch|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: title, agentOpen, onAgentToggle, searchValue, onSearchChange, onSearch, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|title|children|panel|resume|onResume|badges|onRegister|agentOpen|defaultAgentOpen|onAgentToggle|agentScreen|agentMessages|onAgentSend|onAgentAction|sidebarCollapsed|height|style|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: active, onNavigate, title, children, panel, resume, onResume, badges, onRegister, agentOpen, defaultAgentOpen, onAgentToggle, agentScreen, agentMessages, onAgentSend, onAgentAction, sidebarCollapsed, height, style."
